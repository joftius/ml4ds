# instructor/: the complete notebooks and the teacher notes are tracked
# (7 October 2026; the notebooks are released to students after a delay).
# Everything else there stays off GitHub: renders, and anything private
# (exams, problem sets, held problems).
instructor/*
!instructor/weeks/
instructor/weeks/*/*
!instructor/weeks/*/teacher_note*.qmd
!instructor/weeks/*/notebooks/
instructor/weeks/*/notebooks/*
!instructor/weeks/*/notebooks/*_complete.qmd

# Build state. docs/ (including docs/**/*_files/) is committed: it is the site.
# _freeze/ is committed too, so a site render re-executes only what changed.
.quarto/
/.Rproj.user/
/*.Rproj
.DS_Store

/.quarto/
**/*.quarto_ipynb

# Render leftovers beside sources.
weeks/**/*_cache/
weeks/**/*_files/
instructor/**/*_cache/
instructor/**/*_files/
